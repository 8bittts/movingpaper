#!/bin/sh
# Refuse AI attribution. Fails closed: any problem reading the message or the
# identity blocks the commit.
#
# Installed by `scripts/setup-hooks.sh`, run once per clone, which sets `core.hooksPath` to this directory.
# Tested by tests/CommitMsgHookTests.swift.
#
# What it rejects:
#   1. A Co-authored-by or Signed-off-by trailer naming an AI agent (name or email).
#   2. An attribution phrase: "Generated with <agent>", "Generated by <agent>",
#      "Co-authored with <agent>", "AI-assisted/generated/authored", or the
#      robot-emoji "Generated with" line.
#   3. A commit author or committer whose name or email is an AI agent.
# It does NOT reject prose that merely discusses an agent name, such as a docs commit
# about this rule, and a human co-author trailer passes.
# Comment lines and everything below the `git commit -v` scissors are ignored.
set -eu

fail() {
	echo "[FAIL] commit-msg: $1" >&2
	echo "No AI name as author, committer, or in trailers." >&2
	exit 1
}

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -r "$msg_file" ] || fail "the commit message file is unreadable."

authored=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$msg_file") || fail "the commit message could not be read."

# Trailers: any agent name at all, including a bare "cursor".
# "devin", "aider" and "xai" match only as whole agent names, so a human named Devin or Haider passes.
trailer_agent='(claude|codex|cursor|copilot|chatgpt|grok|gpt-|gemini|anthropic|openai|devin-ai|devin\[bot\]|x\.ai|(^|[^[:alnum:]])(aider|xai)([^[:alnum:]]|$))'
# Identity: precise names and emails, so a human whose address merely contains a word passes.
ident_agent='(claude|codex|cursor ?agent|cursoragent|copilot|chatgpt|grok|gpt-[0-9]|gemini|anthropic|openai|devin-ai|(^|[^[:alnum:]])aider([^[:alnum:]]|$)|noreply@anthropic\.com|noreply@openai\.com|noreply@x\.ai)'

hits=$(printf '%s\n' "$authored" | grep -iE "^[[:space:]]*(co-authored-by|signed-off-by):.*$trailer_agent" || true)
if [ -n "$hits" ]; then
	printf '%s\n' "$hits" | sed 's/^/  /' >&2
	fail "a trailer names an AI agent."
fi

if printf '%s\n' "$authored" | grep -qiE "(generated|created|written) (with|by) \[?(claude|codex|cursor|copilot|chatgpt|grok|gemini)|co-authored with (claude|codex|cursor|copilot|chatgpt|grok|gemini)|(^|[[:space:]])ai-(assisted|generated|authored)([[:space:]]|$|\.)|🤖 generated with"; then
	fail "the message credits an AI agent."
fi

for which in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
	ident=$(git var "$which") || fail "could not read $which."
	[ -n "$ident" ] || fail "$which is empty."
	if printf '%s\n' "$ident" | sed 's/>.*$/>/' | grep -qiE "$ident_agent"; then
		fail "$which is an AI agent: $(printf '%s' "$ident" | sed 's/>.*$/>/')"
	fi
done

exit 0
